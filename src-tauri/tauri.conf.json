{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calendário",
  "version": "1.2.0",
  "identifier": "com.felli.calendario",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Calendário",
        "width": 1200,
        "height": 820,
        "minWidth": 860,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://notasimg.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob: http://notasimg.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzREQ3NzIyODk5MzBGMUUKUldRZUQ1T0pJbmZkZ3pxNzVSWExjVW9PbjdqbGpzSC96RTBiWnRRVkdwWjdETzFTUDVFOVJ4L1EK",
      "endpoints": [
        "https://github.com/FellipeFTeixeira/calender/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
